<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS paints while the process starts. Kept identical to the
     Flutter splash underneath it (carbon + the lockup) so there is no flash
     when the engine takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_carbon" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
